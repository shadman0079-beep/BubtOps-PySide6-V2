    @Slot("QVariantMap", result="QVariantMap")
    def saveAsset(self, data):

        try:

            asset_id = int(
                data.get("asset_id") or 0
            )

            asset_code = str(
                data.get("asset_code", "")
            ).strip()

            asset_name = str(
                data.get("asset_name", "")
            ).strip()

            category = str(
                data.get("category", "")
            ).strip()

            asset_condition = str(
                data.get("asset_condition", "Good")
            ).strip()

            status = str(
                data.get("status", "In Service")
            ).strip()

            purchase_date = str(
                data.get("purchase_date", "")
            ).strip()

            if not asset_code or not asset_name or not category:

                return {
                    "success": False,
                    "message": (
                        "Asset code, name and category "
                        "are required."
                    )
                }

            if purchase_date:

                try:

                    datetime.strptime(
                        purchase_date,
                        "%Y-%m-%d"
                    )

                except ValueError:

                    return {
                        "success": False,
                        "message": (
                            "Purchase date must use "
                            "YYYY-MM-DD format."
                        )
                    }

            try:

                purchase_cost = float(
                    str(
                        data.get("purchase_cost", 0)
                    ).replace(",", "").strip() or 0
                )

                estimated_repair_cost = float(
                    str(
                        data.get("estimated_repair_cost", 0)
                    ).replace(",", "").strip() or 0
                )

                if (
                    purchase_cost < 0
                    or estimated_repair_cost < 0
                ):
                    raise ValueError

            except ValueError:

                return {
                    "success": False,
                    "message": (
                        "Enter valid non-negative "
                        "cost values."
                    )
                }

            location_value = data.get("location_id")

            location_id = (
                int(location_value)
                if location_value not in (None, "")
                else None
            )

            allowed_conditions = [
                "Good",
                "Fair",
                "Poor",
                "Damaged",
                "Critical"
            ]

            allowed_statuses = [
                "In Service",
                "Needs Maintenance",
                "Under Maintenance",
                "Out of Service"
            ]

            if asset_condition not in allowed_conditions:

                return {
                    "success": False,
                    "message": "Invalid asset condition."
                }

            if status not in allowed_statuses:

                return {
                    "success": False,
                    "message": "Invalid asset status."
                }

            with self.connect_database() as connection:

                values = (
                    asset_code,
                    asset_name,
                    category,
                    location_id,
                    asset_condition,
                    status,
                    purchase_date or None,
                    purchase_cost,
                    estimated_repair_cost
                )

                if asset_id > 0:

                    connection.execute("""
                        UPDATE assets

                        SET
                            asset_code = ?,
                            asset_name = ?,
                            category = ?,
                            location_id = ?,
                            asset_condition = ?,
                            status = ?,
                            purchase_date = ?,
                            purchase_cost = ?,
                            estimated_repair_cost = ?

                        WHERE asset_id = ?
                    """, values + (asset_id,))

                    message = "Asset updated successfully."

                else:

                    connection.execute("""
                        INSERT INTO assets (
                            asset_code,
                            asset_name,
                            category,
                            location_id,
                            asset_condition,
                            status,
                            purchase_date,
                            purchase_cost,
                            estimated_repair_cost
                        )

                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, values)

                    message = "Asset added successfully."

            self.assetsChanged.emit()

            return {
                "success": True,
                "message": message
            }

        except sqlite3.IntegrityError:

            return {
                "success": False,
                "message": (
                    "Database constraint error. "
                    "Check whether the asset code "
                    "already exists or the location is valid."
                )
            }

        except Exception as error:

            return {
                "success": False,
                "message": str(error)
            }

    # --------------------------------------------------------
    # 09. DELETE ASSET
    # --------------------------------------------------------

    @Slot(int, result="QVariantMap")
    def deleteAsset(self, asset_id):

        try:

            with self.connect_database() as connection:

                linked_records = connection.execute("""
                    SELECT COUNT(*)
                    FROM maintenance_records
                    WHERE asset_id = ?
                """, (asset_id,)).fetchone()[0]

                if linked_records > 0:

                    return {
                        "success": False,
                        "message": (
                            "This asset has maintenance records. "
                            "It cannot be deleted."
                        )
                    }

                cursor = connection.execute("""
                    DELETE FROM assets
                    WHERE asset_id = ?
                """, (asset_id,))

                if cursor.rowcount == 0:

                    return {
                        "success": False,
                        "message": "Asset not found."
                    }

            self.assetsChanged.emit()

            return {
                "success": True,
                "message": "Asset deleted successfully."
            }

        except Exception as error:

            return {
                "success": False,
                "message": str(error)
            }


# ============================================================
# 09. APPLICATION ENTRY POINT
# ============================================================

def main():

    QQuickStyle.setStyle("Basic")

    app = QGuiApplication(sys.argv)

    # Load the application-wide font.
    load_application_font(app)

    view = QQuickView()

    # Create the Python database backend.
    backend = AssetBackend()

    # Make Python functions available to QML.
    view.rootContext().setContextProperty(
        "assetBackend",
        backend
    )

    # Window configuration
    view.setTitle(
        "BubtOps | Advanced Interface"
    )

    view.setResizeMode(
        QQuickView.ResizeMode.SizeRootObjectToView
    )

    # Keep a sensible minimum size so the dashboard layouts do not
    # collapse into one another when the user restores the window.
    view.setMinimumSize(
        QSize(950, 600)
    )

    # Give Windows a sensible restore size. The app still starts maximized,
    # but restoring it will return to a window that fits the current screen.
    screen = app.primaryScreen()
    if screen is not None:
        available = screen.availableGeometry()
        initial_width = min(1200, max(950, available.width() - 80))
        initial_height = min(680, max(600, available.height() - 80))
        initial_x = available.x() + (available.width() - initial_width) // 2
        initial_y = available.y() + (available.height() - initial_height) // 2
        view.setGeometry(
            initial_x,
            initial_y,
            initial_width,
            initial_height
        )

    # Load main QML file
    qml_file = PROJECT_DIR / "main.qml"

    view.setSource(
        QUrl.fromLocalFile(str(qml_file))
    )

    # Check QML errors
    if view.status() == QQuickView.Status.Error:

        for error in view.errors():
            print(error.toString())

        return 1

    # Start maximized so the dashboard has the full usable desktop area
    # immediately instead of opening at the QML design size (1200 x 760).
    view.showMaximized()

    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
