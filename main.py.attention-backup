    # --------------------------------------------------------

    @Slot(result="QVariantList")
    def getCategories(self):

        try:

            with self.connect_database() as connection:

                rows = connection.execute("""
                    SELECT DISTINCT category
                    FROM assets
                    WHERE category IS NOT NULL
                    AND category != ''
                    ORDER BY category
                """).fetchall()

                return [
